# RAG Study Helper v2 local zero-key example.
# First start D:\project-hub\shared-infra, then run this repository's Compose command.

# Only project application and Milvus acceptance endpoints use 19050-19059.
APP_HOST_PORT=19050
MILVUS_HOST_PORT=19055
MILVUS_HEALTH_HOST_PORT=19056

# shared-infra project allocation: MySQL rag_study_helper/rag and Redis DB 3.
MYSQL_USER=rag
MYSQL_PASSWORD=rag-local-app-password
REDIS_PASSWORD=
REDIS_DATABASE=3

# Shared MinIO is required only by docker-compose-milvus.yml.
SHARED_MINIO_ACCESS_KEY=ruoyi
SHARED_MINIO_SECRET_KEY=ruoyi123
MILVUS_BUCKET_NAME=rag-study-helper-milvus

# Mock does not call any model service and needs no API key.
APP_RAG_PROVIDER=mock
APP_RAG_CHAT_API_KEY=
APP_RAG_CHAT_BASE_URL=https://api.deepseek.com
APP_RAG_CHAT_MODEL_NAME=deepseek-v4-flash
APP_RAG_EMBEDDING_API_KEY=
APP_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
APP_RAG_EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
APP_RAG_RERANK_API_KEY=
APP_RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
APP_RAG_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
APP_RAG_SCORE_THRESHOLD=0.77

# Loopback access needs no API key. Remote access requires both settings below.
APP_API_KEY_ENABLED=false
APP_API_KEY=

# Feishu sync is disabled until credentials and a target space are configured.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REMOTE_SPACE_ID=
FEISHU_LOCAL_SPACE_ID=1
FEISHU_SYNC_ENABLED=false

# Use a new collection after changing the embedding dimension.
APP_VECTOR_COLLECTION=rag_study_helper_v2
APP_VECTOR_REBUILD_ON_START=false

# Serve a recent readiness snapshot while one background refresh is in flight.
APP_READINESS_CACHE_MILLIS=500
APP_READINESS_MAX_STALE_MILLIS=5000

LOG_STRUCTURED_FORMAT=ecs
